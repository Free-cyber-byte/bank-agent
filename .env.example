# ZeroStep 本地配置示例：复制为 .env 后按需填写（.env 不会进入 Git）
# 不填也能跑：没有 Key 时自动使用规则解析，36 条评测全部通过。
DEEPSEEK_API_KEY=
# 可选：接入其他 OpenAI 兼容服务时改这两项
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=8
# 可选：LLM 接入加固（v0.3.1，关思考/重试/熔断/用量，按需取消注释）
# DEEPSEEK_BUDGET=10              # 单轮总预算（秒，含重试）
# DEEPSEEK_MAX_TOKENS=800         # 输出 token 上限
# DEEPSEEK_THINKING=disabled      # 思考模式：disabled 关闭（更快更省，默认）
# DEEPSEEK_RETRY=1                # 失败重试次数（仅 429/5xx/网络/超时/空内容/坏 JSON 才重试）
# DEEPSEEK_RETRY_BACKOFF_MS=600
# DEEPSEEK_BREAKER_THRESHOLD=3    # 连续失败多少次临时熔断
# DEEPSEEK_BREAKER_COOLDOWN=60    # 熔断冷却秒数
# 可选：端口 / 关闭演示接口 / 强制规则模式
PORT=8000
DEMO_MODE=1
# ZEROSTEP_DISABLE_LLM=1

# 可选：监听地址与端口（手机同一 WiFi 访问时用 0.0.0.0，然后用电脑局域网 IP 打开）
# HOST=0.0.0.0

# 可选：渠道触达（v0.3.2）——通用 webhook 渠道 + 企业微信回调 + 主动推送
# 通用渠道（backend/channels/server.py，默认 8400）
# CHANNEL_ENABLED=1
# CHANNEL_PORT=8400
# CHANNEL_TOKEN=change-me-channel-token
# 企业微信回调（backend/channels/wecom.py，默认 8401；三项都要填，否则服务返回 503）
# WECOM_ENABLED=1
# WECOM_PORT=8401
# WECOM_TOKEN=change-me-wecom-token
# WECOM_AES_KEY=43位EncodingAESKey
# WECOM_CORP_ID=ww开头的企业CorpID
# WECOM_TIMEOUT=5
# WECOM_DEDUPE_SECONDS=300
# 主动触达（POST /api/push 的推送目标，不填则只生成不推送）
# CHANNEL_PUSH_URL=http://127.0.0.1:9000/push
# CHANNEL_PUSH_TIMEOUT=5
# PUSH_SUBSCRIPTION_DAYS=3
# PUSH_LARGE_TXN_CENTS=30000

# 可选：通用 MCP 服务注册表（v0.6.0）——除内置 fx/risk 外，可接入银行开放平台等外部 MCP 服务
# MCP_SERVERS 为 JSON 数组（单行）；transport 支持 http / streamable-http；鉴权支持 bearer / headers / oauth2。
# 密钥一律写 env:VAR 引用，不要写明文；/api/mcp/status 只返回 auth.type 与 configured，不返回任何密钥。
# MCP_SERVERS=[{"name":"bank","label":"演示银行","url":"http://127.0.0.1:8310/mcp","transport":"streamable-http","tools":["bank_account_summary"],"write_tools":["bank_transfer"],"auth":{"type":"bearer","token":"env:BANK_MCP_TOKEN"}}]
# MCP_MAX_SERVERS=8
# MCP_ALLOW_WRITE_TOOLS=0         # 0（默认）时只允许只读服务；显式 write_tools 永远拒绝，即便设为 1
# 演示银行 MCP 服务的 Bearer token（与 bank_mcp_server.py --token 一致；只放环境变量，.env 不进仓库）
# BANK_MCP_TOKEN=demo-bank-token

# HTTP 边界（v0.6.1）——默认只允许本机同源访问；跨域网页读不到任何 API 响应，也发不出带 Origin 的写请求
# CORS_ALLOW_ORIGINS 为允许的浏览器 Origin（逗号分隔；默认 http://127.0.0.1:8000,http://localhost:8000）
# CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# HOST_ALLOW 追加允许的 Host 主机名（防 DNS rebinding；默认已含 127.0.0.1 / localhost / ::1）
# HOST_ALLOW=myhost.local
# API_TOKEN 非空时，除 GET /api/health 外所有请求都要带 Header: X-ZeroStep-Token（默认空=关闭，纯本机演示建议保持关闭）
# API_TOKEN=change-me-api-token
# 请求体上限 512 KiB；limit 参数统一 clamp 到 1..200
# 演示模式（DEMO_MODE=1，默认）：/api/demo/* 与 /api/admin/reset 仅接受本机回环连接，跨机访问一律 403 DEMO_LOCAL_ONLY
