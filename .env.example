# ZeroStep 本地配置示例：复制为 .env 后按需填写（.env 不会进入 Git）
# 不填也能跑：没有 Key 时自动使用规则解析，36 条评测全部通过。
DEEPSEEK_API_KEY=
# 可选：接入其他 OpenAI 兼容服务时改这两项
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=8
# 可选：LLM 接入加固（v0.3.1，关思考/重试/熔断/用量，按需取消注释）
# DEEPSEEK_BUDGET=10              # 单轮总预算（秒，含重试）
# DEEPSEEK_MAX_TOKENS=800         # 输出 token 上限
# DEEPSEEK_THINKING=disabled      # 思考模式：disabled 关闭（更快更省，默认）
# DEEPSEEK_RETRY=1                # 失败重试次数（仅 429/5xx/网络/超时/空内容/坏 JSON 才重试）
# DEEPSEEK_RETRY_BACKOFF_MS=600
# DEEPSEEK_BREAKER_THRESHOLD=3    # 连续失败多少次临时熔断
# DEEPSEEK_BREAKER_COOLDOWN=60    # 熔断冷却秒数
# 可选：端口 / 关闭演示接口 / 强制规则模式
PORT=8000
DEMO_MODE=1
# ZEROSTEP_DISABLE_LLM=1

# 可选：监听地址与端口（手机同一 WiFi 访问时用 0.0.0.0，然后用电脑局域网 IP 打开）
# HOST=0.0.0.0

# 可选：渠道触达（v0.3.2）——通用 webhook 渠道 + 企业微信回调 + 主动推送
# 通用渠道（backend/channels/server.py，默认 8400）
# CHANNEL_ENABLED=1
# CHANNEL_PORT=8400
# CHANNEL_TOKEN=change-me-channel-token
# 企业微信回调（backend/channels/wecom.py，默认 8401；三项都要填，否则服务返回 503）
# WECOM_ENABLED=1
# WECOM_PORT=8401
# WECOM_TOKEN=change-me-wecom-token
# WECOM_AES_KEY=43位EncodingAESKey
# WECOM_CORP_ID=ww开头的企业CorpID
# WECOM_TIMEOUT=5
# WECOM_DEDUPE_SECONDS=300
# 主动触达（POST /api/push 的推送目标，不填则只生成不推送）
# CHANNEL_PUSH_URL=http://127.0.0.1:9000/push
# CHANNEL_PUSH_TIMEOUT=5
# PUSH_SUBSCRIPTION_DAYS=3
# PUSH_LARGE_TXN_CENTS=30000
